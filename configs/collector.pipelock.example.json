{
  "server": "https://evidencestore.example.internal:8443",
  "ca": "/etc/escollect/server-ca.crt",
  "cert": "/etc/escollect/pipelock.crt",
  "key": "/etc/escollect/pipelock.key",
  "store_key": "PIN-THE-STORE-PUBLIC-KEY-PRINTED-BY-evidencestore-init",
  "spool_dir": "/var/lib/escollect-pipelock",
  "glob": "/var/lib/pipelock/recorder/evidence-*.jsonl",
  "from_start": true,
  "batch": 256,
  "flush_every": "1s"
}
